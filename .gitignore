# Go
/scribe
*.test
*.out

# SQLite (app-side metadata, never committed)
*.db
*.db-shm
*.db-wal

# staging working tree (the blog repo checkout lives outside the build)
/workdir/

# web
/web/node_modules/
/web/dist/

# local config / secrets
.env
.scribe.local.yml

# Local UI build embedded by go:embed; only the placeholder is tracked
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Parked/experimental code, not part of the build
/.parked/
# Local dev run data (SCRIBE_DATA for the throwaway server)
/.run-data/
# Local dev launcher (machine-specific paths)
/.run/
# Editor/agent tooling config (e.g. preview launch.json, machine-specific)
/.claude/
